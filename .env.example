# Токен Telegram-бота (получи бесплатно у @BotFather)
TELEGRAM_BOT_TOKEN=

# Ключ Google Gemini API (получи бесплатно на https://aistudio.google.com/)
# Если ключ пустой — система работает на встроенной умной эвристике
GEMINI_API_KEY=

# Прокси для Telegram (если Telegram заблокирован у провайдера)
# Пример: socks5://127.0.0.1:10808 или http://proxy:port
TELEGRAM_PROXY=

# Интервал проверки новых заказов (в секундах)
CHECK_INTERVAL_SECONDS=45

# Минимальная оценка качества заказа для уведомления (от 1 до 10)
MIN_SCORE_THRESHOLD=6
